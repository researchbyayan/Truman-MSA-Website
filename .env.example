# Anonymous feedback form — email delivery via Gmail SMTP.
# Create these in Vercel: Project → Settings → Environment Variables.
# Never commit real values (this .env is gitignored).

# The Gmail address that sends the feedback emails.
GMAIL_USER=

# A Gmail *App Password* (16 characters), NOT your normal login password.
# Requires 2-Step Verification on the Google account. Generate one at:
# https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# (Optional) Sender display name. Defaults to "Truman MSA Website" if unset.
FEEDBACK_FROM_NAME=
